+    let table = Table::new(
+        &mut store,
+        TableType::new(RefType::FUNCREF, 1, None),
+        Ref::Func(None),
+    )?;
+    let m = Module::new(
+        store.engine(),
+        r#"(module
+            (import "" "" (table 1 funcref))
+            (func $f)
