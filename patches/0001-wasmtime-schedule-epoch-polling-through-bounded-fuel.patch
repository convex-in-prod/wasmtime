+                assert_eq!(float, 1.25 + 13.0 * 0.5);
+                assert_eq!(vector.as_u128(), expected_vector);
+                assert_eq!(store.get_fuel().unwrap(), fuel - 280);
+                assert_eq!(polls > 1, interval.is_some() || mode == 2);
+                match mode {
